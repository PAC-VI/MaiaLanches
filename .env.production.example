# ============================================================
# Modelo do .env de PRODUÇÃO (fica só na VPS, em /opt/maialanches/.env)
#   cp .env.production.example .env   e depois edite os valores
# ============================================================

# Faz o "docker compose" usar o arquivo de produção sem precisar do -f
COMPOSE_FILE=docker-compose.prod.yml

# Domínio do site, SEM https:// e SEM barra no final
# (ex.: maialanches.com.br  ou, sem domínio:  189.24.9.78.sslip.io)
APP_DOMAIN=troque-pelo-seu-dominio.com.br

# Gere com:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Banco de dados (use senhas diferentes e fortes; evite aspas e o caractere $)
DB_DATABASE=maialanches
DB_USERNAME=maia
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-outra-senha

# Minutos até um pedido "novo" passar sozinho para "em preparo" (opcional; padrão 3)
ORDER_AUTO_ACCEPT_MINUTES=3
